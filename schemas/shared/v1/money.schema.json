{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.atlazora.com/schemas/shared/v1/money.schema.json",
  "title": "Money",
  "description": "Currency-aware monetary value represented without JSON floating-point numbers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "amount",
    "currency"
  ],
  "properties": {
    "amount": {
      "type": "string",
      "description": "Base-10 decimal monetary amount. Domain contracts define applicable sign and scale constraints.",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "currency": {
      "type": "string",
      "description": "ISO 4217 three-letter alphabetic currency code.",
      "pattern": "^[A-Z]{3}$"
    }
  }
}
