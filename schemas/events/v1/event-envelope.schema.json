{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atlazora Event Envelope",
  "description": "CloudEvents 1.0 JSON structured event envelope for Atlazora domain events.",
  "type": "object",
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "time",
    "datacontenttype",
    "dataschema",
    "data"
  ],
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "$ref": "../../shared/v1/identifier.schema.json"
    },
    "source": {
      "type": "string",
      "format": "uri-reference"
    },
    "type": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "time": {
      "$ref": "../../shared/v1/timestamp.schema.json"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "dataschema": {
      "type": "string",
      "format": "uri-reference"
    },
    "data": {}
  },
  "additionalProperties": true
}
